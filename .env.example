VITE_BASE_URL=
VITE_APP_URL=
# Web app address for links shared from the desktop app (default https://app.basepoint.co.ke)
VITE_PUBLIC_APP_URL=

VITE_POS_API_KEY=

VITE_TENANT_BASE_URL=

VITE_GOOGLE_MAPS_API_KEY=

VITE_ENTITY_NAME=
VITE_COOP_NAME=

# Sentry Configuration
VITE_SENTRY_DSN=

VITE_AI_DUKA_URL=

# Browser push notifications (Firebase project › Project settings › Your apps ›
# Web app). These are public values. The VAPID key is under Cloud Messaging ›
# Web Push certificates. Leave empty to turn push off.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Christmas config: Santa hat on the logo. on | off | auto (default: 1 Dec - 5 Jan)
VITE_CHRISTMAS_MODE=auto
